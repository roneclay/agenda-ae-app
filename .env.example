# MODO
NODE_ENV=development
AI_MOCK=true
WHATSAPP_MOCK=true
PAYMENT_MOCK=true
EMAIL_MOCK=true

# NICHO
NICHE=beauty

# BANCO — Postgres local via Homebrew
DATABASE_URL=postgresql://postgres@localhost:5432/agendaae_dev

# AUTH — Better Auth
AUTH_SECRET=gerar_com_openssl_rand_base64_32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AUTH — Google OAuth (login/cadastro com Google). Client ID/Secret do
# Google Cloud Console, projeto agendadinho-777c0. Gratuito, sem billing —
# não confundir com o Firebase Phone Auth acima.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# EMAIL — Resend
RESEND_API_KEY=
EMAIL_FROM=AgendaAe <noreply@agendaae.com.br>

# CLAUDE API
ANTHROPIC_API_KEY=

# WHATSAPP
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=agendaae_verify_2026
WHATSAPP_APP_SECRET=

# PAGAMENTO — Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# FIREBASE — Phone Auth (verificação de WhatsApp por SMS), implementado e
# testado mas DESLIGADO por enquanto (billing do Firebase bloqueado no
# Google Cloud). O cadastro hoje garante WhatsApp único via unique constraint
# em user.phone, sem SMS. Preencher e religar quando o billing for liberado.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# FIREBASE — admin (server-only, NUNCA prefixar com NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
